__pycache__/
*.pyc
*.egg-info/
dist/
build/

# --- Secrets / credentials (NEVER commit) ---
.env
.env.*
!.env.example
.env.local
.secret_key
*.secret_key
*.pem
*.key
*.pfx
*.p12
*.crt
secrets.*
# Explicit operator dumps (also covered by secrets/*)
secrets/cloudflared.env
secrets/cloudflared.token
**/ai_settings.json
user_data/**/ai_settings.json

# --- Databases / user data (accounts, password hashes, fetched corpora) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
users.db
users.db-*
.pytest_cache/
.ruff_cache/
user_data/
.venv/
venv/
.claude/

# Verified backup archives (tools/backup.py) — live data + may include .env
backups/
*.tar.gz
*.tar.zst
litsieve-backup-*.tar*

# Governance / product state files (agents.md, spec.md, roadmap.md, context.md,
# CHANGELOG.md) are tracked — do not re-ignore them.

# Local SMTP / provider secret dumps (never commit)
mailersend-smtp.txt
mailersend-*.txt
*smtp*secret*
*smtp*credentials*

# Local operator secrets (Cloudflare Tunnel token, ACME material, etc.)
secrets/*
!secrets/README.md
!secrets/*.example
secrets/letsencrypt/
*.env.save

# Runtime logs (see LOG_FILE in .env.example)
logs/
*.log

# Coverage measurement artefacts
.coverage
htmlcov/

# Dev-server data (see run_dev.sh)
dev_users.db
dev_users.db-*
dev_data/

# Scratch: throwaway design mockups and working notes (not product docs)
design_mockups/
notes.md
