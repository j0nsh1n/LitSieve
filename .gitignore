__pycache__/
*.pyc
*.egg-info/
dist/
build/

# --- Secrets / credentials (NEVER commit) ---
.env
.env.*
!.env.example
.secret_key
*.secret_key
*.pem
*.key
*.pfx
secrets.*

# --- Databases / user data (accounts, password hashes, fetched corpora) ---
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3
.pytest_cache/
.ruff_cache/
user_data/
.venv/
venv/
.claude/

# Governance / product state files (agents.md, spec.md, roadmap.md, context.md,
# CHANGELOG.md) are tracked — do not re-ignore them.

# Local SMTP / provider secret dumps (never commit)
mailersend-smtp.txt
mailersend-*.txt
*smtp*secret*
*smtp*credentials*

# Local operator secrets (DuckDNS token, etc.)
secrets/*
!secrets/README.md
!secrets/*.example
.duckdns.env
duckdns.token
secrets/letsencrypt/
*.env.save
secrets/cloudflared.token
