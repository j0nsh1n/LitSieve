# LitPilot reverse proxy
#
# Default: :8443 (works without root). Router: WAN 443 → LAN 8443
# After:   sudo setcap 'cap_net_bind_service=+ep' ~/bin/caddy
#          use deploy/Caddyfile.privileged (80+443)
{
	auto_https off
	admin off
}

:8443 {
	tls /home/jonathans/HealthDatabaseAccess/secrets/letsencrypt/config/live/litpilot.duckdns.org/fullchain.pem /home/jonathans/HealthDatabaseAccess/secrets/letsencrypt/config/live/litpilot.duckdns.org/privkey.pem

	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy 127.0.0.1:7860 {
		header_up X-Forwarded-Proto https
		header_up X-Forwarded-Host litpilot.duckdns.org
		transport http {
			read_timeout 600s
			write_timeout 600s
		}
	}
}
