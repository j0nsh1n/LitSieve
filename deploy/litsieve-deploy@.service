[Unit]
Description=LitSieve operator deploy for revision %i
Documentation=file://%h/HealthDatabaseAccess/docs/DEPLOY.md
# No PartOf=, BindsTo=, Requires=, or After= against litsieve-uvicorn.service,
# and that absence is the fix for audit finding A04. This unit's job is to
# restart litsieve-uvicorn.service; any coupling would make systemd treat the
# two units as one lifecycle. PartOf= and BindsTo= propagate the web unit's
# stop into this one, so the deploy would die during the very restart it
# triggers (the web unit uses KillMode=control-group, Delegate=no). As an
# independent sibling unit under app.slice, this deploy survives the web
# process stopping, restarting, or failing.

[Service]
Type=oneshot
RemainAfterExit=no
WorkingDirectory=%h/HealthDatabaseAccess

# Same conventions as litsieve-uvicorn.service: secrets live in the
# gitignored .env, and the LITSIEVE_* overrides the deploy helper honors
# (e.g. LITSIEVE_HEALTH_URL, LITSIEVE_LIVE) are read from there too.
EnvironmentFile=-%h/HealthDatabaseAccess/.env

# runner.py sets PYTHONPATH to the repo root when it spawns this script
# (app/operator/actions.py imports app.*). Running tools/operator/deploy.py
# directly puts only tools/operator on sys.path, so the repo root must be
# restored here.
Environment=PYTHONPATH=%h/HealthDatabaseAccess
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin

# Same interpreter as litsieve-uvicorn.service. venv/bin/python is a symlink
# to python3; the venv's site-packages still apply.
ExecStart=%h/HealthDatabaseAccess/venv/bin/python tools/operator/deploy.py %i

# Deploys can take minutes: dependency sync gives pip a 300s budget
# (actions._sync_deps), then a restart and health poll follow, and on failure
# a reset, restart, and second poll. The 90s default would kill a healthy
# deploy mid-flight. Output goes to the journal only.
TimeoutStartSec=900
SyslogIdentifier=litsieve-deploy

# Same light hardening as litsieve-uvicorn.service.
NoNewPrivileges=true
PrivateTmp=true
